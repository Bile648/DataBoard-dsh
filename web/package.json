{
  "name": "dsh-progress-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "开发进度看板：展示 DSH 插件同步过来的任务状态与 md 报告",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "render-check": "esbuild tools/render-check.tsx --bundle --platform=node --format=esm --jsx=automatic --external:react --external:react-dom --outfile=node_modules/.cache/render-check.mjs && node node_modules/.cache/render-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
