# 复制为 .env 后按需修改（docker compose 会自动读取本文件）
# 不要把填好密钥的 .env 提交进版本库。

# 摄入令牌：留空则首次启动自动生成，之后在「设置与管理」页查看或轮换。
# 想固定下来（例如用配置管理下发）就填在这里。
DSH_PROGRESS_INGEST_TOKEN=

# 可选：HMAC 密钥。仅在迁移期需要 —— 用于兼容尚未更新、不发送令牌的旧插件。
# 所有插件都切到令牌后建议清空。
DSH_PROGRESS_SECRET=

# 登录会话有效期（秒），默认 7 天
DSH_PROGRESS_SESSION_TTL=604800

# 走 HTTPS 时必须设为 1
DSH_PROGRESS_SECURE_COOKIE=0

# DEBUG / INFO / WARNING / ERROR
DSH_PROGRESS_LOG_LEVEL=INFO

# 仅 HTTPS 叠加层使用：对外域名
DSH_DOMAIN=
